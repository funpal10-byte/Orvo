{
  "expo": {
    "name": "Orvo",
    "slug": "orvo-original-voice-audit",
    "scheme": "orvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090A",
    "primaryColor": "#C9A94A",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#08090A"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.orvo.audit",
      "backgroundColor": "#08090A"
    },
    "android": {
      "package": "co.orvo.audit",
      "adaptiveIcon": {
        "backgroundColor": "#08090A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#08090A"
    },
    "extra": {
      "supabaseUrl": "https://hpyguusedttrwribiynq.supabase.co",
      "supabaseAnonKey": "sb_publishable_euhlQ3T6CFGbDJ6FrSHe2w_hnyiYxOV"
    }
  }
}
